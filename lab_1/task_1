import random
import os

ALPHABET = "АБВГДЕЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯ "

def generate_key():
    shuffled = list(ALPHABET)
    random.shuffle(shuffled)
    return {orig: sub for orig, sub in zip(ALPHABET, shuffled)}

def process_text(text, key):
    return "".join(key.get(char.upper(), char) for char in text)

def save(path, content):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, 'w', encoding='utf-8') as f:
        f.write(content if isinstance(content, str) else 
                "\n".join(f"{k} -> {v}" for k, v in content.items()))

def main():
    text = """
    Противоположная точка зрения подразумевает, что активно развивающиеся страны третьего мира призывают нас к новым свершениям, которые, в свою очередь, должны быть представлены в исключительно положительном свете. А также некоторые особенности внутренней политики будут описаны максимально подробно. Равным образом, высококачественный прототип будущего проекта создаёт необходимость включения в производственный план целого ряда внеочередных мероприятий с учётом комплекса существующих финансовых и административных условий.
    """
    
    key = generate_key()
    encrypted = process_text(text, key)
    decrypted = process_text(encrypted, {v: k for k, v in key.items()})
    
    # Сохранение результатов
    save("task1_data/task1_source.txt", text)
    save("task1_data/task1_encrypted.txt", encrypted)
    save("task1_data/task1_key.txt", key)
    save("task1_data/task1_decrypted.txt", decrypted)
    
    # Тихая проверка
    assert text.strip().upper() == decrypted.strip().upper(), "Ошибка расшифровки!"
    print("Готово. Файлы сохранены в lab_1/data/")

if __name__ == "__main__":
    main()